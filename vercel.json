{
  "services": {
    "frontend": {
      "root": "./",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/authority",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/report",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}